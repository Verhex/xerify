{
  "name": "xerify-cli",
  "version": "0.3.1",
  "description": "Verify before you trust. Cross-provider verification with LLMs and Jev. CLI, library, MCP.",
  "mcpName": "io.github.verhex/xerify",
  "author": {
    "name": "Verhex",
    "url": "https://github.com/Verhex"
  },
  "homepage": "https://github.com/Verhex/xerify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verhex/xerify.git"
  },
  "bugs": {
    "url": "https://github.com/Verhex/xerify/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "xerify": "./dist/cli/entry.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tools",
    "schemas",
    "skills",
    "scripts/postinstall.mjs",
    "README.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.tr.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!**/.env",
    "!**/.env.*",
    "!**/.env~"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "assets:logo": "node scripts/export-logo.mjs",
    "assets:flow": "node assets/readme/render-verification-flow.mjs",
    "check": "npm run format:check && npm run secrets:check && npm run docs:links && npm run lint && npm run typecheck && npm test && npm run build",
    "docs:links": "node scripts/verify-doc-links.mjs",
    "generate:schemas": "npm run build && node scripts/export-schemas.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "postinstall": "node ./scripts/postinstall.mjs",
    "prepack": "npm run generate:schemas && npm run secrets:check",
    "release:audit": "npm run generate:schemas && npm run assets:logo && node scripts/release-audit.mjs",
    "smoke:mcp": "npm run build && node scripts/verify-mcp-inspector.mjs",
    "smoke:live": "npm run build && node scripts/live-provider-smoke.mjs",
    "smoke:install": "node scripts/verify-install.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "secrets:check": "node scripts/check-env-boundaries.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "2.2.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^20.19.43",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "xerify",
    "verification",
    "jev",
    "typesafe",
    "xverify",
    "ai",
    "cli",
    "mcp",
    "cross-provider",
    "deckent",
    "verhex"
  ]
}
